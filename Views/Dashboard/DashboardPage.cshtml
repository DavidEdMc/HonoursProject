@model List<HonoursProject.Models.LeaderboardEntry>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <!-- Header -->
    <h1 class="dashboard-title">Welcome back, @ViewBag.Username</h1>
    <p class="dashboard-subtitle">Here’s your learning overview</p>

    <!-- Continue Learning Card -->
    @await Html.PartialAsync("_Card", new CardViewModel {
        Title = "Continue Learning",
        Subtitle = "Your last lesson: Lesson Title Placeholder",
        ButtonText = "Resume Lesson →",
        ButtonUrl = Url.Action("LessonPage", "Lesson")
    })

    <!-- Leaderboard Card (moved ABOVE the stat grid) -->
    @await Html.PartialAsync("_Leaderboard", Model)

    <!-- Grid Layout -->
    <div class="dashboard-grid">
        <!-- Lessons Completed (entire card clickable) -->
        <a href="@Url.Action("LessonSelectionPage", "Lesson")" class="app-card-link-wrapper">
            @await Html.PartialAsync("_Card", new CardViewModel {
                Variant = "app-card-stat app-card-clickable",
                Content = new HtmlString(@"
                    <div class='stat-value'>20%</div>
                    <div class='stat-label'>Lessons Completed</div>
                ")
            })
        </a>

        <!-- Achievements Earned (entire card clickable) -->
        <a href="@Url.Action("AchievementsPage", "Account", new { from = "dashboard" })" class="app-card-link-wrapper">
            @await Html.PartialAsync("_Card", new CardViewModel {
                Variant = "app-card-stat app-card-clickable",
                Content = new HtmlString(@"
                    <div class='stat-value'>0</div>
                    <div class='stat-label'>Achievements Earned</div>
                ")
            })
        </a>

        <!-- Current Streak (not clickable) -->
        @await Html.PartialAsync("_Card", new CardViewModel {
            Variant = "app-card-stat",
            Content = new HtmlString(@"
                <div class='stat-value'>0</div>
                <div class='stat-label'>Day Streak</div>
            ")
        })
    </div>

    <!-- Recommended Lessons -->
    @await Html.PartialAsync("_Card", new CardViewModel {
        Title = "Recommended Lessons",
        Content = new HtmlString(@"
            <p>Start with these lessons to continue your progress:</p>

            <div class='recommended-list'>
                <div class='recommended-item'>
                    <h4>Lesson Placeholder 1</h4>
                    <a class='btn' href='/Lesson/LessonPage'>Start →</a>
                </div>

                <div class='recommended-item'>
                    <h4>Lesson Placeholder 2</h4>
                    <a class='btn' href='/Lesson/LessonPage'>Start →</a>
                </div>
            </div>
        ")
    })
</div>
