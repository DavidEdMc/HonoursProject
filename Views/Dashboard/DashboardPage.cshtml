@model HonoursProject.Models.DashboardViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <!-- Header -->
    <h1 class="dashboard-title">Welcome back, @Model.Username</h1>
    <p class="dashboard-subtitle">Here’s your learning overview</p>

    <!-- Grid Layout -->
    <div class="dashboard-grid">

        <!-- Lessons Completed -->
        <a href="@Url.Action("LessonSelectionPage", "Lesson")" class="app-card-link-wrapper">
            @await Html.PartialAsync("_Card", new CardViewModel {
                Variant = "app-card-stat app-card-clickable",
                Content = new HtmlString($@"
                    <div class='stat-value'>{Model.LessonsCompleted}</div>
                    <div class='stat-label'>Lessons Completed</div>
                ")
            })
        </a>

        <!-- Achievements Earned -->
        <a href="@Url.Action("AchievementsPage", "Account", new { from = "dashboard" })" class="app-card-link-wrapper">
            @await Html.PartialAsync("_Card", new CardViewModel {
                Variant = "app-card-stat app-card-clickable",
                Content = new HtmlString($@"
                    <div class='stat-value'>{Model.AchievementsEarned}</div>
                    <div class='stat-label'>Achievements Earned</div>
                ")
            })
        </a>

        <!-- Current Streak -->
        @await Html.PartialAsync("_Card", new CardViewModel {
            Variant = "app-card-stat",
            Content = new HtmlString($@"
                <div class='stat-value'>{Model.DayStreak}</div>
                <div class='stat-label'>Day Streak</div>
            ")
        })
    </div>

    <!-- Leaderboard Card -->
    @await Html.PartialAsync("_Leaderboard", Model.Leaderboard)
    
</div>