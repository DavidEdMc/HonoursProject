@{
    ViewData["Title"] = "Home";
}
<div class="hero-container">
    <div class="hero-mascot">
        <!-- Placeholder for duck mascot image -->
        <img src="~/assets/images/duck-minimalist.png" alt="Mascot Duck" />
    </div>

    <div class="hero-content">
        <h1 class="hero-title">Welcome back!</h1>
        <p class="hero-subtitle">Ready to learn something new today?</p>

        <a class="btn btn-hero" asp-controller="Lesson" asp-action="LessonSelectionPage">Select a lesson</a>
        <a class="btn btn-hero" asp-controller="Dashboard" asp-action="DashboardPage">Go to Dashboard</a>
    </div>
</div>

<section class="main-wrapper text-center">
    <h1 class="main-header">Honours Project</h1>
    <p class="lead">Welcome to the prototype application for my final-year project.</p>
    <p class="author">by David E McIntyre</p>
</section>
