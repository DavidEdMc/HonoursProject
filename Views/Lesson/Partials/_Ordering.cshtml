@model HonoursProject.Models.Question

@{
    // Shuffle items randomly for display
    var shuffled = Model.Options
        .OrderBy(o => Guid.NewGuid())
        .ToList();
}

<div class="ordering-container">

    <p>Drag the items into the correct order:</p>

    <ul id="orderingList" class="ordering-list">
        @foreach (var item in shuffled)
        {
            <li class="ordering-item"
                draggable="true"
                data-id="@item.id"
                data-order="@item.order_position">
                @item.option_text
            </li>
        }
    </ul>

</div>

<div id="orderingFeedback" class="feedback"></div>

<button id="orderingNextBtn"
        class="btn btn-lesson"
        style="display:none;"
        onclick="nextQuestion()">
    Next Question
</button>

<script>
    const list = document.getElementById("orderingList");
    let draggedItem = null;

    list.addEventListener("dragstart", e => {
        draggedItem = e.target;
        e.dataTransfer.effectAllowed = "move";
    });

    list.addEventListener("dragover", e => {
        e.preventDefault();
        const target = e.target.closest(".ordering-item");
        if (target && target !== draggedItem) {
            const rect = target.getBoundingClientRect();
            const next = (e.clientY - rect.top) / (rect.height) > 0.5;
            list.insertBefore(draggedItem, next ? target.nextSibling : target);
        }
    });

    list.addEventListener("drop", e => {
        checkOrder();
    });

    function checkOrder() {
        const items = document.querySelectorAll(".ordering-item");
        let correct = true;

        items.forEach((item, index) => {
            const correctPos = parseInt(item.dataset.order);
            if (correctPos !== index + 1) {
                correct = false;
            }
        });

        const feedback = document.getElementById("orderingFeedback");

        if (correct) {
            feedback.innerHTML = "<span class='correct'>Correct order!</span>";
            document.getElementById("orderingNextBtn").style.display = "block";
        } else {
            feedback.innerHTML = "<span class='incorrect'>Incorrect order. Try again.</span>";
        }
    }
</script>
