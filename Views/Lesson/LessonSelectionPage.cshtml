@model LessonSelectionPageViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Select a Lesson";
}

<div class="lesson-selection-container">

    <h1 class="lesson-selection-title">Choose Your Lesson</h1>
    <p class="lesson-selection-subtitle">Pick a topic to begin learning</p>

    <div class="lesson-grid">

        @foreach (var item in Model.Lessons)
        {
            var lesson = item.Lesson;

            @await Html.PartialAsync("_Card", new CardViewModel {
                Title = lesson.title,
                Subtitle = lesson.description,
                ImageUrl = lesson.IconPath,
                ButtonText = item.IsUnlocked ? "Start Lesson" : "Locked",
                ButtonUrl = item.IsUnlocked ? Url.Action("View", "Lesson", new { id = lesson.id }) : "#",
                IsLocked = !item.IsUnlocked
            })
        }

    </div>

    @if (Model.Exam != null)
    {
        <div class="exam-row">
            @await Html.PartialAsync("_Card", new CardViewModel {
                Title = Model.Exam.Lesson.title,
                Subtitle = Model.Exam.Lesson.description,
                ImageUrl = Model.Exam.Lesson.IconPath,
                ButtonText = Model.Exam.IsUnlocked ? "Start Exam" : "Locked",
                ButtonUrl = Model.Exam.IsUnlocked ? Url.Action("View", "Lesson", new { id = Model.Exam.Lesson.id }) : "#",
                IsLocked = !Model.Exam.IsUnlocked,
                CustomClasses = "exam-card"
            })
        </div>
    }

</div>
