@{
    Layout = "_Layout";
    ViewData["Title"] = "Select a Lesson";
}

<div class="lesson-selection-container">

    <h1 class="lesson-selection-title">Choose Your Lesson</h1>
    <p class="lesson-selection-subtitle">Pick a topic to begin learning</p>

    <div class="lesson-grid">

        <!-- Placeholder Lesson Card 1 -->
        <div class="lesson-card">
            <img src="~/images/duck-minimalist.png" class="lesson-card-icon" alt="Lesson Icon" />
            <h3 class="lesson-card-title">Lesson 1: Introduction</h3>
            <p class="lesson-card-desc">A gentle introduction to the basics.</p>
            <a asp-controller="Lesson" asp-action="LessonPage" class="btn btn-lesson">Start Lesson</a>
        </div>

        <!-- Placeholder Lesson Card 2 -->
        <div class="lesson-card">
            <img src="~/images/duck-minimalist.png" class="lesson-card-icon" alt="Lesson Icon" />
            <h3 class="lesson-card-title">Lesson 2: Intermediate Concepts</h3>
            <p class="lesson-card-desc">Build on what you've learned.</p>
            <a asp-controller="Lesson" asp-action="LessonPage" class="btn btn-lesson">Start Lesson</a>
        </div>

        <!-- Placeholder Lesson Card 3 -->
        <div class="lesson-card">
            <img src="~/images/duck-minimalist.png" class="lesson-card-icon" alt="Lesson Icon" />
            <h3 class="lesson-card-title">Lesson 3: Advanced Topics</h3>
            <p class="lesson-card-desc">Challenge yourself with deeper material.</p>
            <a asp-controller="Lesson" asp-action="LessonPage" class="btn btn-lesson">Start Lesson</a>
        </div>

    </div>

</div>
