@{
    Layout = "_Layout";
    ViewData["Title"] = "Select a Lesson";
}

<div class="lesson-selection-container">

    <h1 class="lesson-selection-title">Choose Your Lesson</h1>
    <p class="lesson-selection-subtitle">Pick a topic to begin learning</p>

    <div class="lesson-grid">

       @await Html.PartialAsync("_Card", new CardViewModel {
            Title = "Lesson 1: Introduction",
            Subtitle = "A gentle introduction to the basics.",
            ImageUrl = "/images/duck-minimalist.png",
            Variant = "app-card-clickable",
            ButtonText = "Start Lesson",
            ButtonUrl = Url.Action("LessonPage", "Lesson")
        })



        @await Html.PartialAsync("_Card", new CardViewModel {
            Title = "Lesson 2: Intermediate Concepts",
            Subtitle = "Build on what you've learned.",
            ImageUrl = "/images/duck-minimalist.png",
            Variant = "app-card-clickable",
            ButtonText = "Start Lesson",
            ButtonUrl = Url.Action("LessonPage", "Lesson")
        })


        @await Html.PartialAsync("_Card", new CardViewModel {
            Title = "Lesson 3: Advanced Topics",
            Subtitle = "Challenge yourself with deeper material.",
            ImageUrl = "/images/duck-minimalist.png",
            Variant = "app-card-clickable",
            ButtonText = "Start Lesson",
            ButtonUrl = Url.Action("LessonPage", "Lesson")
        })
    </div>

</div>
