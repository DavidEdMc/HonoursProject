@model HonoursProject.Models.Lesson

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.title;
}

<div class="lesson-page-container">
    
    @await Html.PartialAsync("_BackToLessonsButton")

    <div class="lesson-header">
        <h1 class="lesson-title">@Model.title</h1>
        <p class="lesson-subtitle">@Model.description</p>
    </div>

    <hr />

    <div class="lesson-content">
        <h2>Lesson Overview</h2>
        <p>
            This is placeholder lesson content. Interactive questions will appear here
            once the lesson runner is implemented.
        </p>

        <img src="~/images/duck-minimalist.png" class="lesson-mascot" alt="Mascot" />

        <p>
            Click below to begin the interactive lesson.
        </p>
    </div>

    <hr />

    <a class="btn btn-lesson" href="@Url.Action("Start", "Lesson", new { id = Model.id })">
        Start Lesson
    </a>

    <div class="lesson-navigation">
        <a class="btn btn-lesson" href="#">Previous</a>
        <a class="btn btn-lesson" href="#">Next</a>
    </div>

</div>
