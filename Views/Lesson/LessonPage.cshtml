@model HonoursProject.Models.Lesson

@{
    Layout = "_Layout";
    ViewData["Title"] = Model.title;
}

<div class="lesson-page-container">
    
    @await Html.PartialAsync("_BackToLessonsButton")

    <div class="lesson-header">
        <h1 class="lesson-title">@Model.title</h1>
        <p class="lesson-subtitle">@Model.description</p>
    </div>

    <hr />
    
    <div class="lesson-content">
        @if (!string.IsNullOrWhiteSpace(Model.ContentHtml))
        {
            @Html.Raw(Model.ContentHtml)
        }
        else
        {
            <p>No lesson content has been added yet.</p>
        }
    </div>

    <hr />

    <div class="lesson-cta">
        <a class="btn btn-lesson" href="@Url.Action("Start", "Lesson", new { id = Model.id })">
            Start Quiz
        </a>
    </div>

    <div class="lesson-navigation">
        @if (ViewBag.PreviousId != null)
        {
            <a class="btn btn-lesson" href="@Url.Action("View", "Lesson", new { id = ViewBag.PreviousId })">
                Previous
            </a>
        }
        else
        {
            <span></span> <!-- keeps spacing -->
        }

        @if (ViewBag.NextId != null)
        {
            <a class="btn btn-lesson" href="@Url.Action("View", "Lesson", new { id = ViewBag.NextId })">
                Next
            </a>
        }
        else
        {
            <span></span>
        }
    </div>
</div>
