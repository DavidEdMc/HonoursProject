@{
    Layout = "_Layout";
    ViewData["Title"] = "Lesson";
}

<div class="lesson-page-container">
    
    @await Html.PartialAsync("_BackToLessonsButton")

    <div class="lesson-header">
        <h1 class="lesson-title">Lesson Title Placeholder</h1>
        <p class="lesson-subtitle">A brief description of what this lesson covers</p>
    </div>

    <hr />

    <div class="lesson-content">
        <h2>Section Title</h2>
        <p>
            This is placeholder lesson content. You can replace this with text, images, 
            diagrams, videos, or interactive elements later.
        </p>

        <img src="~/images/duck-minimalist.png" class="lesson-mascot" alt="Mascot" />

        <p>
            Add more content here to build out the lesson structure. This page is designed 
            to be flexible and expandable.
        </p>
    </div>

    <hr />

    <div class="lesson-navigation">
        <a class="btn btn-lesson" href="#">Previous</a>
        <a class="btn btn-lesson" href="#">Next</a>
    </div>

</div>
