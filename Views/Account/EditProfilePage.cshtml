@{
    Layout = "_Layout";
    ViewData["Title"] = "Edit Profile";
}

<div class="edit-profile-container">

    @await Html.PartialAsync("_BackToProfileButton")
    <h1 class="edit-profile-title">Edit Profile</h1>
    <p class="edit-profile-subtitle">Update your personal information</p>

    <hr />

    <form class="edit-profile-form" asp-controller="Account" asp-action="EditProfile" method="post" enctype="multipart/form-data">
        <!-- Username -->
        <div class="edit-profile-field">
            <label for="username">Username</label>
            <input type="text" id="username" name="Username" value="@Model.Username" required />
        </div>

        <!-- Email -->
        <div class="edit-profile-field">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="EmailAddress" value="@Model.EmailAddress" required />
        </div>

        <!-- Avatar -->
        <div class="edit-profile-field">
            <label for="avatar">Profile Picture</label>
            <input type="file" id="avatar" name="AvatarFile" />
        </div>

        <button type="submit" class="btn btn-edit-profile">Save Changes</button>

    </form>
    @if (TempData["ProfileMessage"] != null)
    {
        <div class="alert alert-success mt-3">
            @TempData["ProfileMessage"]
        </div>
    }

</div>
