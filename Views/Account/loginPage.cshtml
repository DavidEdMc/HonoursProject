@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}


<div class="auth-container">

    <div class="auth-mascot">
        <img src="~/images/duck-minimalist.png" alt="Mascot Duck" />
    </div>

    <h1 class="auth-title">Welcome Back</h1>
    <p class="auth-subtitle">Sign in to continue your learning journey</p>

    <form class="auth-form" method="get" action="/Home/Index">

        <div class="form-group mb-3">
            <label for="username">Username</label>
            <input id="username" class="form-control" type="text" placeholder="Enter your username" />
        </div>

        <div class="form-group mb-3">
            <label for="password">Password</label>
            <input id="password" class="form-control" type="password" placeholder="Enter your password" />
        </div>

        <button type="submit" class="btn btn-auth">Sign In</button>

        <a class="auth-forgot" href="/Account/ForgotPassword">Forgot your password?</a>

    </form>

</div>
