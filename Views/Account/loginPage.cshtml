@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}


<div class="auth-container">

    <div class="auth-mascot">
        <img src="/assets/images/duck-minimalist.png" alt="Mascot Duck" />
    </div>

    <h1 class="auth-title">Welcome Back</h1>
    <p class="auth-subtitle">Sign in to continue your learning journey</p>

    <form class="auth-form" method="post" asp-action="Login" asp-controller="Account">

        <div class="form-group mb-3">
            <label for="username">Username</label>
            <input id="username" name="username" class="form-control" type="text" placeholder="Enter your username" required />
        </div>

        <div class="form-group mb-3">
            <label for="password">Password</label>
            <input id="password" name="password" class="form-control" type="password" placeholder="Enter your password" required />
        </div>

        <button type="submit" class="btn btn-auth">Sign In</button>

        <a class="auth-forgot" href="/Account/ForgotPassword">Forgot your password?</a>
        <p class="auth-register">
            Don’t have an account?
            <a asp-controller="Account" asp-action="RegisterPage">Create one →</a>
        </p>

        @if (ViewBag.Error != null)
        {
            <p class="text-danger mt-2">@ViewBag.Error</p>
        }
        @if (TempData["RegisterMessage"] != null)
        {
            <div class="alert alert-danger mt-3">
                @TempData["RegisterMessage"]
            </div>
        }


    </form>
</div>
