@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="auth-container">

    <div class="auth-mascot">
        <img src="/assets/images/duck-minimalist.png" alt="Mascot Duck" />
    </div>

    <h1 class="auth-title">Forgot Password?</h1>
    <p class="auth-subtitle">Enter your email and we’ll help you reset it</p>

    <form class="auth-form" method="post" asp-controller="Account" asp-action="ForgotPassword">
        <div class="form-group mb-3">
            <label for="email">Email Address</label>
            <input id="email" name="EmailAddress" class="form-control" type="email" placeholder="Enter your email" required />
        </div>
        <button type="submit" class="btn btn-auth">Reset Password</button>

        <a class="auth-forgot" href="/Account/LoginPage">Back to Sign In</a>
    </form>

    @if (TempData["ResetMessage"] != null)
    {
        <div class="alert alert-info mt-3">
            @TempData["ResetMessage"]
        </div>
    }

</div>
