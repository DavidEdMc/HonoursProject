@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset Password";
}

<div class="auth-container">

    <div class="auth-mascot">
        <img src="~/images/duck-minimalist.png" alt="Mascot Duck" />
    </div>

    <h1 class="auth-title">Forgot Password?</h1>
    <p class="auth-subtitle">Enter your email and we’ll help you reset it</p>

    <form class="auth-form" method="get" action="/Account/ResetConfirmation">

        <div class="form-group mb-3">
            <label for="email">Email Address</label>
            <input id="email" class="form-control" type="email" placeholder="Enter your email" />
        </div>

        <button type="submit" class="auth-button">Send Reset Link</button>

        <a class="auth-forgot" href="/Account/LoginPage">Back to Sign In</a>
    </form>

</div>
