@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}

<div class="change-password-container">
    
    @await Html.PartialAsync("_BackToProfileButton")

    <h1 class="change-password-title">Change Password</h1>
    <p class="change-password-subtitle">Update your password to keep your account secure</p>

    <hr />

    <form class="change-password-form" asp-controller="Account" asp-action="ChangePassword" method="post">

        <div class="change-password-field">
            <label for="current-password">Current Password</label>
            <input type="password" id="current-password" name="CurrentPassword" placeholder="Enter current password" required />
        </div>

        <div class="change-password-field">
            <label for="new-password">New Password</label>
            <input type="password" id="new-password" name="NewPassword" placeholder="Enter new password" required />
        </div>

        <div class="change-password-field">
            <label for="confirm-password">Confirm New Password</label>
            <input type="password" id="confirm-password" name="ConfirmPassword" placeholder="Re-enter new password" required />
        </div>

        <button type="submit" class="btn btn-change-password">Save Changes</button>

    </form>

    @if (TempData["PasswordMessage"] != null)
    {
        <div class="alert alert-info mt-3">
            @TempData["PasswordMessage"]
        </div>
    }

</div>