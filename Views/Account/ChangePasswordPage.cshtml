@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Password";
}

<div class="change-password-container">
    
    @await Html.PartialAsync("_BackToProfileButton")

    <h1 class="change-password-title">Change Password</h1>
    <p class="change-password-subtitle">Update your password to keep your account secure</p>

    <hr />

    <form class="change-password-form">

        <!-- Current Password -->
        <div class="change-password-field">
            <label for="current-password">Current Password</label>
            <input type="password" id="current-password" placeholder="Enter current password" disabled />
        </div>

        <!-- New Password -->
        <div class="change-password-field">
            <label for="new-password">New Password</label>
            <input type="password" id="new-password" placeholder="Enter new password" disabled />
        </div>

        <!-- Confirm New Password -->
        <div class="change-password-field">
            <label for="confirm-password">Confirm New Password</label>
            <input type="password" id="confirm-password" placeholder="Re-enter new password" disabled />
        </div>

        <p class="change-password-note">Password changing will be enabled in a future update</p>

        <button type="submit" class="change-password-button" disabled>Save Changes</button>

    </form>

</div>
