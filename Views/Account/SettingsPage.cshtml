@{
    Layout = "_Layout";
    ViewData["Title"] = "Settings";
}

<div class="settings-container">
    
    @await Html.PartialAsync("_BackToProfileButton")
    
    <h1 class="settings-title">Settings</h1>
    <p class="settings-subtitle">Manage your preferences and app experience</p>

    <hr />

    <!-- Theme Settings -->
    <div class="settings-section">
        <h2>Appearance</h2>
        <div class="settings-item">
            <label for="theme-toggle">Dark Mode</label>

            <label class="switch">
                <input type="checkbox" id="theme-toggle" disabled>
                <span class="slider round"></span>
            </label>
        </div>
        <p class="settings-note">Coming Soon!</p>
    </div>

    <hr />

    <!-- Notifications -->
    <div class="settings-section">
        <h2>Notifications</h2>
        <div class="settings-item">
            <label for="notifications">Email Notifications</label>

            <label class="switch">
                <input type="checkbox" id="notifications" disabled>
                <span class="slider round"></span>
            </label>
        </div>
        <p class="settings-note">Coming Soon!</p>
    </div>

    <hr />

    <!-- Accessibility -->
    <div class="settings-section">
        <h2>Accessibility</h2>
        <div class="settings-item">
            <label for="text-size">Large Text</label>

            <label class="switch">
                <input type="checkbox" id="text-size" disabled>
                <span class="slider round"></span>
            </label>
        </div>
        <p class="settings-note">Coming Soon!</p>
    </div>


</div>
