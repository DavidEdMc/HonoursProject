@model List<HonoursProject.Models.AchievementViewModel>

@{
    Layout = "_Layout";
    ViewData["Title"] = "Achievements";
    var from = Context.Request.Query["from"].ToString();
}

<div class="achievements-container">

    @if (from == "dashboard")
    {
        @await Html.PartialAsync("_BackToDashboardButton")
    }
    else
    {
        @await Html.PartialAsync("_BackToProfileButton")
    }

    <h1 class="achievements-title">Your Achievements</h1>
    <p class="achievements-subtitle">Track your progress and unlock new badges</p>

   @{
    var grouped = Model
        .OrderBy(a => a.Category)
        .GroupBy(a => a.Category);
    }

    @foreach (var categoryGroup in grouped)
    {
        <h2 class="achievement-category-title">@char.ToUpper(categoryGroup.Key[0])@categoryGroup.Key.Substring(1)</h2>
        <hr class="achievement-category-divider" />

        <div class="achievements-grid">
            @foreach (var a in categoryGroup)
            {
                var unlocked = a.IsUnlocked;
                var cardClass = unlocked ? "achievement-card unlocked" : "achievement-card locked";
                var iconClass = unlocked ? "achievement-icon" : "achievement-icon locked-icon";

                <div class="@cardClass" data-category="@a.Category">
                    <img src="~/assets/images/achievements/@a.Category-icon.png" class="@iconClass" alt="Badge" />

                    <h3 class="achievement-name">@a.Name</h3>
                    <p class="achievement-desc">@a.Description</p>

                    @if (!unlocked)
                    {
                        <p class="achievement-locked-label">Locked</p>
                    }
                </div>
            }
        </div>
    }
</div>
