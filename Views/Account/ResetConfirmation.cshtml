@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Email Sent";
}

<div class="auth-container">

    <div class="auth-mascot">
        <img src="~/images/duck-minimalist.png" alt="Mascot Duck" />
    </div>

    <h1 class="auth-title">Check Your Email</h1>
    <p class="auth-subtitle">If an account exists for that email, you’ll receive a reset link shortly.</p>

    <a href="/Account/LoginPage" class="btn btn-auth d-block text-center">Return to Login</a>

</div>
