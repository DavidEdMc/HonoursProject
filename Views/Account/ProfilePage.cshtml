@model HonoursProject.Models.ProfileViewModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Your Profile";
}

<div class="profile-container">

    <div class="profile-header">
        <img class="profile-avatar"
            src="@(string.IsNullOrEmpty(Model.ProfilePicture) 
                    ? Url.Content("~/images/duck-minimalist.png") 
                    : Model.ProfilePicture)"
            alt="Profile Avatar" />


        <div class="profile-info">
            <h1 class="profile-name">@Model.Username</h1>
            <p class="profile-email">@Model.EmailAddress</p>
            <p class="level-badge">Level @Model.Level</p>
            <div class="xp-bar">
                <div class="xp-fill" style="width:@((Model.CurrentXp * 100) / (Model.Level * 100))%;"></div>
            </div>
            <p>XP to next level: <strong>@Model.XpToNextLevel</strong></p>
        </div>
    </div>


    <hr />

    <div class="profile-section">
        <h2>Progress Overview</h2>
        <p>Total Lessons Completed: <strong>@Model.LessonsCompleted</strong></p>
        <p>Current Streak: <strong>@Model.DayStreak days</strong></p>
    </div>

    <hr />

    <div class="profile-section">
        <h2>Your Achievements</h2>
        <p>See your badges, streaks, and progress milestones.</p>
        <p>Achievements Earned: <strong>@Model.AchievementsEarned</strong></p>
        <a class="btn" asp-controller="Account" asp-action="AchievementsPage" asp-route-from="profile">
            View Achievements →
        </a>

    </div>

    <hr />

    <div class="profile-section">
        <h2>Account Settings</h2>

        <a class="btn" asp-controller="Account" asp-action="ChangePasswordPage">Change Password</a>
        <a class="btn" asp-controller="Account" asp-action="EditProfilePage">Edit Profile</a>
        <a class="btn" asp-controller="Account" asp-action="SettingsPage">Settings</a>
    </div>

</div>
